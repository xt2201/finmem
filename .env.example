OPENAI_API_KEY = "Enter your OpenAI API Key here"
# US news: alpaca | openrouter | auto (auto = Alpaca only, same key rotation as alpaca; no OpenRouter fallback)
FINMEM_US_NEWS_SOURCE = "alpaca"
# Comma-separated extra .env files with alternate ALPACA_* and SEC_KEY (used on 429 / quota)
# FINMEM_ROTATE_ENV_FILES = ".env.work,.env.linh"
OPENROUTER_API_KEY = "Optional: only when FINMEM_US_NEWS_SOURCE=openrouter"
FINMEM_OPENROUTER_MODEL = "deepseek/deepseek-v4-flash"
# Comma-separated fallbacks for US news OpenRouter calls on 429/502/503 (defaults: qwen/qwen3.6-35b-a3b, qwen/qwen3-32b)
# FINMEM_OPENROUTER_NEWS_MODEL_FALLBACKS = "qwen/qwen3.6-35b-a3b,qwen/qwen3-32b"
# FINMEM_OPENROUTER_MODEL_FALLBACK_SLEEP_SECONDS = "3"
FINMEM_OPENROUTER_MAX_SNIPPETS = "25"
HF_TOKEN = "Enter your Hugging Face token here"
SEC_KEY = "Enter your SEC API key here"
ALPACA_API_KEY = "Enter your Alpaca API key here"
ALPACA_API_SECRET_KEY = "Enter your Alpaca API secret key here"
ALPACA_ENDPOINT = "https://paper-api.alpaca.markets/v2"
ALPACA_NEWS_ENDPOINT = "https://data.alpaca.markets/v1beta1/news"
FINMEM_SUMMARY_MODEL="llama3.1-8b" # llama3.1-8b, gpt-oss-120b, qwen-3-235b-a22b-instruct-2507, zai-glm-4.7
VNSTOCK_API_KEY = "Enter your VNStock API key here"
CEREBRAS_API_KEY = "Required for VN mode (see README)"
# VN build: translate Vietnamese news before VADER (needs sentencepiece + HF access)
FINMEM_VN_TRANSLATE_FOR_VADER=1
FINMEM_VN_TRANSLATION_LOCAL_ONLY=0
#
# Quota / key rotation (local only; do not commit real keys):
# Put alternates in e.g. `.env.linh` then: set -a; source scripts/source_env_stack.sh .env .env.linh; set +a
# Bash `source` needs KEY=value without spaces; Python data build still reads spaced lines from `.env`.